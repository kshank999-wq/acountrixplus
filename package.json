{
  "name": "accountrix-plus",
  "version": "0.1.0",
  "private": true,
  "description": "Accountrix Plus \u2014 a unified business operating system for bookkeeping, accounting, clients, proposals, and marketing.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "worker": "tsx src/worker.ts",
    "worker:once": "tsx src/worker-once.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:backup": "bash scripts/backup.sh",
    "db:verify-restore": "bash scripts/verify-restore.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
