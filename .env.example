# ---------------------------------------------------------------------------
# Accountrix Plus — environment template
# Copy to `.env.local` (git-ignored) and fill in real values.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string for the application database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/accountrix

# Separate database used by `npm test`. MUST NOT point at your dev database:
# the test harness truncates every table between suites.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/accountrix_test

# --- Sessions (required in production) -------------------------------------
# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A development fallback is used when unset, but the app refuses to boot in
# production without a real value.
SESSION_SECRET=

# Encrypts secrets held in the database — today, TOTP secrets (spec §19).
# Required in production; a development fallback applies without it.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Bank aggregation provider ---------------------------------------------
# Which BankProvider adapter to use: `mock` (built in, no credentials needed)
# or a real aggregator once its adapter is implemented.
# Spec §3 requires provider-specific code stay behind this abstraction.
BANK_PROVIDER=mock

# Real aggregator credentials (unused while BANK_PROVIDER=mock).
# Never expose these to the browser — server-side only.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# --- Email delivery (spec §10) ---------------------------------------------
# Which EmailProvider adapter to use: `mock` (built in, records messages in
# memory and sends nothing) or a real ESP once its adapter is implemented.
EMAIL_PROVIDER=mock

# Absolute base URL for links inside sent email — unsubscribe, click tracking,
# and the open pixel. Unlike an in-app link these cannot be relative: they are
# opened days later from a different origin. MUST be set before a real send.
PUBLIC_BASE_URL=http://localhost:3000

# --- AI module (optional, spec §11/§12) ------------------------------------
# The AI module is off by default for every company, and the core bookkeeping,
# accounting, proposal, and marketing workflows never require it (spec §23).
# Switching it on is a per-company setting in the app, not an env var.
#
# Which AiProvider adapter a company may select. `mock` is built in: it answers
# from heuristics, needs no credentials, and is what the demo and the tests
# use. `anthropic` needs the key below.
AI_PROVIDER=mock

# Provider credentials stay server-side and are never exposed to the browser
# (spec §12, §19). Unset means the `anthropic` adapter reports itself
# unconfigured and the gateway falls back to the mock rather than failing.
# ANTHROPIC_API_KEY=

# --- Background worker (spec §18) ------------------------------------------
# Run with `npm run worker`, as a separate process from the web app. Without
# one, nothing scheduled ever runs: no campaign sends, no reminders, no
# proposed entries — and none of that raises an error anywhere, which is why
# /settings/operations leads with whether a worker is alive.
#
# Several workers can run at once; they claim different jobs rather than the
# same one.
#
# How often each worker polls for due work, in milliseconds.
# WORKER_POLL_MS=5000
#
# How many jobs one worker claims per tick.
# WORKER_BATCH_SIZE=10

# --- Payroll and tax (spec §13, §19) ---------------------------------------
# Which PayrollProvider adapter supplies payroll figures.
#
#   manual        (default) Calculates nothing. Takes what a payroll bureau
#                 already worked out and records it, posting the journal entry.
#                 This is how most small businesses run payroll, and it is the
#                 only answer this codebase can give honestly — withholding
#                 depends on jurisdiction, filing status, year-to-date position,
#                 and rules that change annually.
#   illustrative  Invented flat rates, for the demo and the tests. They match no
#                 jurisdiction. Every run is stamped `is_illustrative`, every
#                 screen says so, and it blocks a filing.
#
# Unlike every other provider registry here, THERE IS NO FALLBACK: an
# unrecognised value throws rather than quietly substituting a different source
# of payroll figures. Provider credentials stay server-side (spec §12, §19).
#
# Nothing in this module is reviewed for production use. Spec §19 requires a
# security review before payroll or tax filing is relied on.
PAYROLL_PROVIDER=manual

# --- Mobile app and push notifications (spec §3, §18, §19) -----------------
# Which PushProvider adapter to use: `mock` (built in — records notifications
# and delivers none, which is what the demo and tests run on) or `webpush`.
PUSH_PROVIDER=mock

# VAPID keys for Web Push. Generate with:
#   npx web-push generate-vapid-keys
# The private key never leaves the server; only the public key reaches the
# browser, which is what it is for. Unset means the `webpush` adapter reports
# itself unconfigured and the registry falls back to the mock.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourcompany.com

# NOTE: service workers require HTTPS or localhost. Over plain HTTP the app
# runs normally and registers no service worker, so nothing works offline.

# --- Transactional email (spec §19, §14) -----------------------------------
# The channel password resets and invitations go down. Deliberately separate
# from the marketing sender: a TransactionalMessage has no unsubscribe field to
# fill in, because you cannot unsubscribe from your own password reset.
#
# `mock` (the default) records every letter in memory and, when NODE_ENV is
# development, prints it — with its link — to the terminal. That is how /forgot
# works with no mail server: the token is hashed the moment it is stored, so
# the terminal is the only place the link can be read.
#
# Any other value must have an adapter registered at startup with
# registerTransactionalProvider(). An unknown name throws rather than falling
# back, because a deployment that believes it configured a real sender and is
# in fact dropping every reset into memory is discovered by a support ticket.
TRANSACTIONAL_EMAIL_PROVIDER=mock

# Who transactional mail comes from. Deliberately not the company's own brand:
# a reset that arrives looking like it came from the customer's own business is
# one nobody can distinguish from a phishing attempt.
# TRANSACTIONAL_FROM_NAME=Accountrix Plus
# TRANSACTIONAL_FROM_EMAIL=no-reply@yourdomain.example

# Base URL for links in transactional mail. Must be the address people actually
# reach the app on — a reset link pointing at localhost is a dead link.
# PUBLIC_BASE_URL=https://books.yourdomain.example

# --- Object storage for attachments (spec §18, §13) ------------------------
# Where scanned evidence goes: supplier invoices, receipts, bank statements.
# Separate from the brand asset library, and addressed by the SHA-256 of the
# content — so the same PDF attached to a bill, its payment, and the month's
# journal entry is stored once.
#
# `database` (the default) keeps bytes in Postgres, so a backup of the database
# is a backup of the evidence and the demo needs no credentials. Not what
# should hold a decade of scans.
#
# `filesystem` writes them under OBJECT_STORE_PATH, fanned out by digest.
OBJECT_STORE=database
# OBJECT_STORE_PATH=/var/lib/accountrix/objects

# NOTE: the object store is deliberately NOT partitioned by tenant — two
# companies holding identical bytes share them. That is safe only because
# nothing is reachable through the store: every read starts from a `documents`
# row already filtered by company. Do not add a route that takes a digest.
