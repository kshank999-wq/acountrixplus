# ---------------------------------------------------------------------------
# Accountrix Plus — environment template
# Copy to `.env.local` (git-ignored) and fill in real values.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string for the application database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/accountrix

# Separate database used by `npm test`. MUST NOT point at your dev database:
# the test harness truncates every table between suites.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/accountrix_test

# --- Sessions (required in production) -------------------------------------
# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A development fallback is used when unset, but the app refuses to boot in
# production without a real value.
SESSION_SECRET=

# --- Bank aggregation provider ---------------------------------------------
# Which BankProvider adapter to use: `mock` (built in, no credentials needed)
# or a real aggregator once its adapter is implemented.
# Spec §3 requires provider-specific code stay behind this abstraction.
BANK_PROVIDER=mock

# Real aggregator credentials (unused while BANK_PROVIDER=mock).
# Never expose these to the browser — server-side only.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# --- Email delivery (spec §10) ---------------------------------------------
# Which EmailProvider adapter to use: `mock` (built in, records messages in
# memory and sends nothing) or a real ESP once its adapter is implemented.
EMAIL_PROVIDER=mock

# Absolute base URL for links inside sent email — unsubscribe, click tracking,
# and the open pixel. Unlike an in-app link these cannot be relative: they are
# opened days later from a different origin. MUST be set before a real send.
PUBLIC_BASE_URL=http://localhost:3000

# --- AI module (optional, spec §11/§12) ------------------------------------
# The AI module is off by default for every company, and the core bookkeeping,
# accounting, proposal, and marketing workflows never require it (spec §23).
# Switching it on is a per-company setting in the app, not an env var.
#
# Which AiProvider adapter a company may select. `mock` is built in: it answers
# from heuristics, needs no credentials, and is what the demo and the tests
# use. `anthropic` needs the key below.
AI_PROVIDER=mock

# Provider credentials stay server-side and are never exposed to the browser
# (spec §12, §19). Unset means the `anthropic` adapter reports itself
# unconfigured and the gateway falls back to the mock rather than failing.
# ANTHROPIC_API_KEY=

# --- Mobile app and push notifications (spec §3, §18, §19) -----------------
# Which PushProvider adapter to use: `mock` (built in — records notifications
# and delivers none, which is what the demo and tests run on) or `webpush`.
PUSH_PROVIDER=mock

# VAPID keys for Web Push. Generate with:
#   npx web-push generate-vapid-keys
# The private key never leaves the server; only the public key reaches the
# browser, which is what it is for. Unset means the `webpush` adapter reports
# itself unconfigured and the registry falls back to the mock.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourcompany.com

# NOTE: service workers require HTTPS or localhost. Over plain HTTP the app
# runs normally and registers no service worker, so nothing works offline.
